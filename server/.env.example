# PostgreSQL is the active adapter by default.
TDD_RESULTS_REPOSITORY=database
TDDLAB_DATABASE_URL=postgresql://user:password@localhost:5432/tddlab
# Set false only for a local PostgreSQL instance without TLS.
TDDLAB_DATABASE_SSL=false
# Used only by FileTDDResultsRepository when TDD_RESULTS_REPOSITORY=file.
TDD_JSON_DIRECTORY=./data/tdd-results
# Must point to an isolated database, never the team's shared database.
TDDLAB_TEST_DATABASE_URL=postgresql://user:password@localhost:5432/tddlab_hu08

{
  "hosting": {
    "target": "production",
    "public": "dist",
    "ignore": [
      "firebase.staging.json",
      "firebase.production.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
